//mesmo se parecendo com o prisma de todas as empresas esse sera o master

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  GOD // USUARIO COM PODERES DE DEUS NO SISTEMA
  ADMIN
  GESTOR
  ATENDENTE
}

enum modulo{
  OFICINA
  CORPORATIVO
  EVENTOS
  COMERCIAL
}

enum statusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
  REEMBOLSADO
}

// Planos dinâmicos do SaaS — criados/ editados pelo GOD
model planos {
  id                 String   @id @default(uuid())
  slug               String   @unique      // ex.: "start", "profissional"
  nome               String                 // ex.: "Start"
  preco              Float                  // valor mensal
  descricao          String   @default("")
  maxModulos         Int      @default(-1)  // -1 = ilimitado (todos)
  maxUsuarios        Int      @default(5)
  botIA              Boolean  @default(false)
  canais             String[] @default([])  // ["app", "whatsapp", "telegram"]
  modulosAutomaticos String[] @default([])  // [] = escolha livre; preenchido = todos
  ativo              Boolean  @default(true)
  destaque           Boolean  @default(false) // badge "Recomendado"
  ordem              Int      @default(0)
  extincaoEm         DateTime?               // quando o plano será extinto (30 dias após solicitação)
  extincaoAvisadaEm  DateTime?               // quando o aviso de extinção foi disparado
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ativo, ordem])
}

// prisma/schema.prisma
model empresa {
  id              String    @id @default(uuid())
  nome            String    @unique
  cnpj            String    @unique
  setores         String[]
  statusPagamento statusPagamento @default(PENDENTE) // status do pagamento SaaS (Asaas)
  asaasCustomerId String?   // id do cliente no Asaas
  asaasSubscriptionId String? // id da assinatura no Asaas
  asaasPaymentId  String?   // id do último pagamento no Asaas
  trialAtivo      Boolean   @default(true) // true enquanto estiver no período de teste
  trialUsado      Boolean   @default(false) // true se a empresa já consumiu a degustação trial (não pode usar de novo)
  evolution_url   String?                    // URL base da API de WhatsApp do cliente (BYO)
  evolution_token String?                    // token de autenticação do webhook emitido pelo NoLevel
  provider        String    @default("EVOLUTION") // qual API de WhatsApp o cliente usa (EVOLUTION | META | ...)
  api_key         String?                    // credencial de ENVIO do provedor do cliente (só GOD vê)
  logoUrl         String?                    // URL da logo da empresa
  botName         String?                    // Nome do assistente virtual para esta empresa
  botPresentation String?                    // Input: como o bot deve se apresentar
  botServiceDesc  String?                    // Input: como o bot deve atender
  botAvisosDesc   String?                    // Input: como apresentar os avisos
  botPrompt       String?                    // Prompt consolidado gerado pela OpenAI
  users           User[]
  chamados        Chamado[]
  cpfs            cpfs[]
  avisos          avisos[]
  modulos         modulo[]
  databaseUrl     String? // URL de conexão específica para esta empresa
  plano           String   @default("start") // slug do plano de assinatura (tabela planos)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([nome])
  @@index([cnpj])
}

//não precisa relacionar com os usuarios porque vai ser um banco por empresa
model User {
  id        String    @id @default(uuid())
  empresaId String
  Empresa   empresa   @relation(fields: [empresaId], references: [id])
  email     String    @unique
  cpf       String    @unique
  name      String
  role      ROLE
  avatarUrl String?
  setor     String
  resumo    String?
  password  String
  chamados  Chamado[] @relation("AtendenteChamados")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([empresaId])
  @@index([cpf])
  @@index([email])
}

model Chamado {
  id          String   @id @default(uuid())
  Empresa     empresa  @relation(fields: [empresaId], references: [id])
  empresaId   String
  ticket      String   @unique
  nome        String
  cpf         String
  setor       String
  descricao   String
  historico   String?
  status      String   @default("NOVO")
  prioridade  String   @default("normal")
  anexoUrl    String?
  atendenteId String?
  atendente   User?    @relation("AtendenteChamados", fields: [atendenteId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empresaId])
  @@index([cpf])
  @@index([status])
  @@index([empresaId, status])
  @@index([ticket])
}

// Modelo para armazenar CPFs e nomes dos usuários autorizados a usar o chatbot
model cpfs {
  id        String   @id @default(uuid())
  cpf       String   @unique
  empresaId String
  Empresa   empresa  @relation(fields: [empresaId], references: [id])
  telefone  String?
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([cpf])
}

//para gerar os dashboards de chamados fechados, para não poluir a tabela principal
model tickets_fechados {
  id         String   @id @default(uuid())
  ticket     String   @unique
  nome       String
  cpf        String
  setor      String
  historico  String?
  prioridade String
  anexoUrl   String?
  atendente  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cpf])
  @@index([ticket])
}

//representa o quadro de avisos da empresa
model avisos {
  id             String    @id @default(uuid())
  empresaId      String
  Empresa        empresa   @relation(fields: [empresaId], references: [id])
  titulo         String
  prompt_bot     String?
  nome_bot       String?
  conteudo       String
  setor          String?
  duracao        String?
  destinatarioCpf String? // CPF ou matricula quando a entrega for especifica para um usuario
  logoUrl        String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId])
  @@index([setor])
  @@index([destinatarioCpf])
}



model resumoPersona {
  id        String   @id @default(uuid())
  cpf       String   @unique
  nome      String
  resumo    String //resumo da persona gerado pelo gpt, para ele se lembrar da personalidade do usuário
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cpf])
}

model cpfsLeads{
  id        String   @id @default(uuid())
  cpf       String   @unique
  nome      String
  telefone  String
  empresa   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cpf])
  @@index([telefone])
}

model logs_de_acesso{
  id        String   @id @default(uuid())
  cpf       String?
  nome      String?
  empresa   String
  modulo    modulo
  acao      String //ex: "login", "criou chamado", "fechou chamado", etc.
  createdAt DateTime @default(now())
  @@index([cpf])
  @@index([empresa])
  @@index([modulo]) 
}

//contabilizar os chamados evitados pelo bot, para mostrar no dashboard o quanto o bot tem ajudado a reduzir a carga de trabalho dos atendentes humanos
model tickets_evitados{
  id         String   @id @default(uuid())
  nome       String
  empresaId  String
  cpf        String
  setor      String
  descricao  String
  prioridade String
  anexoUrl   String?
  atendente  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

}

model cache {
  key       String   @id
  value     String
  expiresAt DateTime
}